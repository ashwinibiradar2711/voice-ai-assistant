# Copy this file to .env and fill in your values.

# One free Groq key powers both Whisper (speech-to-text) and the LLM (answers).
# Get it at https://console.groq.com/keys
API_BASE_URL=https://api.groq.com/openai/v1
API_KEY=your-groq-api-key

# --- Speech-to-text: "groq" (cloud Whisper, fast) or "local" (faster-whisper on CPU)
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
LOCAL_WHISPER_SIZE=base

# --- Language model (check https://console.groq.com/docs/models for current names)
LLM_MODEL=openai/gpt-oss-20b
TEMPERATURE=0.6
MAX_TOKENS=1024
# For reasoning models like gpt-oss: low / medium / high. Leave empty for other models.
REASONING_EFFORT=low
HISTORY_TURNS=6

# --- Text-to-speech: "edge" (free neural voices, needs internet) or "offline" (pyttsx3)
TTS_PROVIDER=edge
